# Mesma service account do Fundo Bíblico (church-inventory-orders).
# Tem de ser uma pasta num Drive compartilhado (Shared Drive). Pastas pessoais do
# Drive não aceitam upload da service account (sem cota).
# ID abaixo = pasta "Documentos" do Fundo Bíblico. O app cria a subpasta Catalogo/.

GOOGLE_DRIVE_FOLDER_ID="12INsanCVXNwIxa_AmwAujk3_0oUuIdn8"

# JSON da service account em uma linha (copie de church-inventory-orders/.env):
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Ou, em vez do JSON, o caminho do arquivo (só no computador local):
# GOOGLE_APPLICATION_CREDENTIALS="/caminho/para/google-service-account.json"

PORT=3847
